{
    "version": "2.0.0",
    "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
    },
    "tasks": [
        {
            "label": "Start Cooja",
            "type": "shell",
            "command": "cd ~/contiki-ng/tools/cooja && ./gradlew run",
            "presentation": {
                "group": "simulation",
                "panel": "new"
            }
        },
        {
            "label": "Start Border Router (Cooja)",
            "type": "shell",
            "command": "cd ./src/Gateway && make TARGET=cooja connect-router-cooja",
            "presentation": {
                "group": "simulation",
                "panel": "new"
            }
        },
        {
            "label": "Start Cloud Server",
            "type": "shell",
            "command": "cd ./src/CloudApp && python3 server.py",
            "presentation": {
                "group": "simulation",
                "panel": "new"
            }
        },
        {
            "label": "Start Cloud App",
            "type": "shell",
            "command": "cd ./src/CloudApp && python3 app.py",
            "presentation": {
                "group": "simulation",
                "panel": "new"
            }
        },
        {
            "label": "Flash Border Router (Dongle)",
            "type": "shell",
            "command": "cd ./src/Gateway && make TARGET=nrf52840 BOARD=dongle PORT=/dev/ttyACM0 border-router.dfu-upload",
            "presentation": {
                "group": "hardware",
                "panel": "new"
            }
        },
        {
            "label": "Start Border Router (Dongle Tunslip)",
            "type": "shell",
            "command": "cd ./src/Gateway && make TARGET=nrf52840 BOARD=dongle connect-router PORT=/dev/ttyACM0",
            "presentation": {
                "group": "hardware",
                "panel": "new"
            }
        },
        {
            "label": "Flash Printer Node (Dongle)",
            "type": "shell",
            "command": "cd ./src/Printer3D && make TARGET=nrf52840 BOARD=dongle device.dfu-upload PORT=/dev/ttyACM1",
            "presentation": {
                "group": "hardware",
                "panel": "new"
            }
        },
        {
            "label": "Login Printer Node (Dongle)",
            "type": "shell",
            "command": "cd ./src/Printer3D && make login TARGET=nrf52840 BOARD=dongle PORT=/dev/ttyACM1",
            "presentation": {
                "group": "hardware",
                "panel": "new"
            }
        }
    ]
}